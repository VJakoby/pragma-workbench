    <div class="content-panel hidden-panel" id="contentPanel">
      <div class="drag-handle drag-handle-left" id="contentPanelHandle"></div>
      <div class="content-panel-hdr">
        <button class="icon-btn" id="cpBackBtn" onclick="goBackContentPanel()" title="Back to list" style="display:none"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
        <button class="icon-btn" id="cpCreateBtn" onclick="openContentPanelCreate()" title="Create new" style="display:none"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></button>
        <span class="content-panel-icon" id="cpIcon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg></span>
        <span class="content-panel-title" id="cpTitle">&mdash;</span>
        <span class="content-panel-meta" id="cpMeta"></span>
        <button class="icon-btn" id="cpEditBtn" onclick="toggleEditMode()" title="Edit file" style="display:none"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
        <button class="icon-btn danger" id="cpDeleteBtn" onclick="deleteActiveKbDocument()" title="Delete file" style="display:none"><svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg></button>
        <button class="content-panel-close" onclick="closeContent()">&times;</button>
      </div>
      <div class="content-panel-tabs" id="cpQuickTabs" style="display:none"></div>
      <div class="content-panel-searchbar" id="cpSearchBar" style="display:none">
        <div class="local-search content-panel-search">
          <span class="local-search-icon">&#8981;</span>
          <input type="text" id="cpSearchInput" placeholder="Find in document…" autocomplete="off" spellcheck="false" oninput="updateContentPanelSearch()" onkeydown="handleContentPanelSearchKey(event)">
        </div>
        <span class="content-panel-search-count" id="cpSearchCount">0</span>
        <button class="content-panel-search-btn" id="cpSearchPrevBtn" onclick="stepContentPanelSearch(-1)" title="Previous match" aria-label="Previous match">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="content-panel-search-btn" id="cpSearchNextBtn" onclick="stepContentPanelSearch(1)" title="Next match" aria-label="Next match">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
      <div class="content-panel-body" id="cpReadBody">
        <div class="md-content" id="cpContent"></div>
      </div>
      <div class="content-panel-edit" id="cpEditBody" style="display:none">
        <div class="cp-edit-toolbar">
          <span class="cp-edit-status" id="cpEditStatus"></span>
          <button class="tb-btn" id="kbPreviewBtn" onclick="toggleKbPreview()" title="Toggle markdown preview">
            <span style="display:flex;align-items:center;gap:5px"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Preview</span>
          </button>
          <div class="syntax-theme-picker" style="margin-left:2px" aria-label="Editor syntax theme">
            <button class="syntax-dot" type="button" data-theme="quietlight" style="--dot-color:#007acc" onclick="setSyntaxTheme('quietlight')" title="Quiet Light" aria-label="Quiet Light"></button>
            <button class="syntax-dot" type="button" data-theme="monokai" style="--dot-color:#f92672" onclick="setSyntaxTheme('monokai')" title="Monokai" aria-label="Monokai"></button>
            <button class="syntax-dot" type="button" data-theme="nord" style="--dot-color:#88c0d0" onclick="setSyntaxTheme('nord')" title="Nord" aria-label="Nord"></button>
            <button class="syntax-dot" type="button" data-theme="solarized" style="--dot-color:#859900" onclick="setSyntaxTheme('solarized')" title="Solarized" aria-label="Solarized"></button>
          </div>
          <div class="editor-font-controls" title="Editor font controls">
            <div class="editor-font-family-group" role="group" aria-label="Editor font family">
              <button class="editor-font-choice" data-font="classic" onclick="setEditorFontFamily('classic')" title="Use classic editor font rendering">Classic</button>
              <button class="editor-font-choice" data-font="mono" onclick="setEditorFontFamily('mono')" title="Use JetBrains Mono editor font">Mono</button>
              <button class="editor-font-choice" data-font="plex" onclick="setEditorFontFamily('plex')" title="Use IBM Plex Mono editor font">Plex</button>
            </div>
            <div class="editor-font-size-group" role="group" aria-label="Editor font size">
              <button class="editor-font-btn" onclick="decreaseEditorFont()" title="Decrease editor font">A-</button>
              <button class="editor-font-label editor-font-size-label" data-editor-font-size-label="1" onclick="resetEditorFont()" title="Reset editor font size">14px</button>
              <button class="editor-font-btn" onclick="increaseEditorFont()" title="Increase editor font">A+</button>
            </div>
          </div>
        </div>
        <div class="note-md-hint">
          <span># h1</span><span>## h2</span><span>**bold**</span><span>*italic*</span>
          <span><code>`code`</code></span><span><code>```block```</code></span><span>- list</span><span>1. list</span><span>- [ ] task</span><span>&gt; quote</span>
          <span title="Wiki link to another note">[[internal-link]]</span>
        </div>
        <div class="kb-editor-split" id="kbEditorSplit">
          <div class="cm-wrap kb-editor" id="cpEditWrap"></div>
          <div class="note-preview-handle kb-preview-handle" id="kbPreviewHandle" style="display:none"></div>
          <div class="note-preview-pane kb-preview-pane" id="kbPreviewPane" style="display:none">
            <div class="note-preview-label">Preview</div>
            <div class="md-content note-preview-content kb-preview-content" id="kbPreviewContent"></div>
          </div>
        </div>
      </div>
    </div>
