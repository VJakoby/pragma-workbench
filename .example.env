###############################################################################
# PRAGMA // Workbench
# Copy this file to .env
###############################################################################
# Bind address and port for the application.
PRAGMA_BIND=127.0.0.1:3000:3000

# Permissions for the container user. 
# By default, it runs as UID/GID 1000 (the first non-root user on most systems) to avoid permission issues with mounted volumes. 
# You can change these if needed.
PRAGMA_UID=1000
PRAGMA_GID=1000

# Paths for persistent storage of knowledge base and sessions. These are relative to the project root and will be mounted into the container.
PRAGMA_KB_PATH=./knowledge-base
PRAGMA_SESSIONS_PATH=./sessions

# Single PDF option. 
# Disabled by default. Set true to enable PDF export, then rebuild so Chromium is omitted from the image.
PDF_EXPORT_ENABLED=false

# Additional modules/integrations
# TOOLBOX module
TOOLBOX_ENABLED=false
TOOLBOX_URL=http://127.0.0.1:3003
TOOLBOX_URLS=http://matrix:3003,http://host.docker.internal:3003,http://127.0.0.1:3003

# ENGRAM module
ENGRAM_SEARCH_ENABLED=false
SEARCH_URL=http://engram:3002
